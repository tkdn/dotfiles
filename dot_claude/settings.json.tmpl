{
  {{ if env "CALUDE_AWS_PROFILE" }}
  "awsAuthRefresh": "aws sso login --profile {{ env "CALUDE_AWS_PROFILE" }}",
  "env": {
    "AWS_PROFILE": "{{ env "CALUDE_AWS_PROFILE"  }}"
  },
  {{ end }}
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go list:*)",
      "Bash(golangci-lint run:*)",
      "Bash(goimports:*)",
      "Bash(go generate:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git verify-commit:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run download*)",
      "Bash(gh run watch*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(sed:*)",
      "Bash(exit 1)",
      "Bash(python3 -:*)",
      "Bash(code:*)",
      "Bash(crit:*)",
      "Bash(gh stack init:*)",
      "Bash(gh stack view:*)",
      "Bash(gh stack modify:*)",
      "Bash(gh stack rebase:*)",
      "Bash(gh stack add:*)",
      "Bash(gh stack checkout:*)",
      "Bash(gh stack unstack:*)",
      "Bash(gh stack bottom:*)",
      "Bash(gh stack down:*)",
      "Bash(gh stack switch:*)",
      "Bash(gh stack up:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Read(.env.*)",
      "Read(.env)",
      "Read(.envrc)",
      "Bash(git push:*)"
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "crit@crit": true,
    "modern-go-guidelines@goland-claude-marketplace": true,
    "cosense-cli@cosense-cli": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
    "goland-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "JetBrains/go-modern-guidelines"
      }
    },
    "cosense-cli": {
      "source": {
        "source": "github",
        "repo": "helpfeel/cosense-cli"
      }
    }
  },
  {{ if eq .chezmoi.os "linux" }}
  {{   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); TITLE=$(echo \"$INPUT\" | jq -r '.title // \"通知\"'); MSG=$(echo \"$INPUT\" | jq -r '.message // \"Claude Codeからの通知\"'); /mnt/c/opt/go-tosast/toast64.exe --app-id 'Claude Code' --title \"$TITLE\" --message \"$MSG\" --audio 'default' --duration 'short'"
          }
        ]
      }
    ]
  },
  {{   end }}
  {{ end }}
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "ﾜｧ…",
      "なんとかなれーっ",
      "ﾊｰｯ!!!",
      "ヤーッ！",
      "討伐ッ！",
      "うま…",
      "泣いちゃった…",
      "やだッ…",
      "こわいよォ…",
      "しんど…",
      "どうして…",
      "えらいッ",
      "がんばったねッ",
      "うれしいッ",
      "でかつよ…",
      "草むしり検定…",
      "合格ッ",
      "不合格…",
      "やりなおしッ",
      "ギチギチ…",
      "オデ…",
      "フッ…",
      "すごいッ",
      "イヤッ",
      "むちゃうま…"
    ]
  },
  "alwaysThinkingEnabled": false,
  "advisorModel": "fable",
  "theme": "dark-daltonized",
  "tui": "fullscreen"
}
